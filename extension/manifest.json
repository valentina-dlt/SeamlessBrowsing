{
  "manifest_version": 3,
  "name": "Cookie Calm",
  "version": "0.1.1",
  "description": "Quietly reject optional cookies. Local processing, with a pause for each site.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Calm"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
